%%% Custom derivation environments (w/ or w/o automatic step numbering)
\preto\tabular{\setcounter{theproofstep}{0}}
\newcounter{theproofstep}
\newcommand\proofstep{\stepcounter{theproofstep}\arabic{theproofstep}}
\newenvironment{derivation}{\renewcommand{\arraystretch}{0.9}\setlength{\tabcolsep}{12pt}\begin{center}\begin{tabular}{>{\makebox[0em][r]{\footnotesize\proofstep}\hspace{2\tabcolsep}} l >{\footnotesize}l}}{\end{tabular}\end{center}\vspace{0.5em}}
\newenvironment{derivation*}{\renewcommand{\arraystretch}{0.9}\setlength{\tabcolsep}{12pt}\begin{center}\begin{tabular}{>{\footnotesize}l l >{\footnotesize}l}}{\end{tabular}\end{center}\vspace{0.5em}}
