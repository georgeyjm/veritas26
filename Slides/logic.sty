\newcommand{\LL}{\mathcal{L}}
\newcommand{\Lprop}{\LL_\textrm{prop}}
\newcommand{\struct}[1]{\mathcal{#1}}
\newcommand{\tostruct}[2]{#1^\struct{#2}}
\newcommand{\valunder}[2]{\abs{#1}_\struct{#2}}
\newcommand{\interp}{\struct{I}}
\newcommand{\SQ}{\mathrm{SQ}}

\newcommand{\true}{\textit{T}}
\newcommand{\false}{\textit{F}}
\newcommand{\hash}{\scalebox{0.8}[0.9]{\raisebox{0.2ex}{\textbf{\#}}}}
\newcommand{\settf}{\set{\true, \false}}
\newcommand{\settfh}{\set{\true, \false, \hash}}
\newcommand{\pred}{\operatorname}

\renewcommand{\implies}{\rightarrow}
\renewcommand{\iff}{\leftrightarrow}
\renewcommand{\models}{\mathrel{|}\joinrel\mkern-.5mu\mathrel{=}} % Connect two parts
\newcommand{\entails}{\models}
\newcommand{\proves}{\mathrel{|}\joinrel\mkern-1mu\mathrel{-}} % Bigger than \vDash, consistent with \models
\newcommand{\lequiv}{\models\mkern-5mu\mathrel{\text{\reflectbox{$\models$}}}}
\newcommand{\logeq}{\dot=}
\newcommand{\oset}[1]{\left\langle #1 \right\rangle}

\newcommand{\conj}{\bigwedge}
\newcommand{\disj}{\bigvee}

\newcommand{\val}[1][v]{\tilde{#1}}

